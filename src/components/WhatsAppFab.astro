---
/**
 * Floating WhatsApp button — fixed bottom-right on every page.
 * wa.me opens the WhatsApp app on phones and WhatsApp Web / Desktop on computers.
 * Only the round button is clickable; the tooltip never blocks content behind it.
 */
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n';
import { whatsappUrl } from '../config/site';

interface Props {
  lang: Lang;
}
const t = useT(Astro.props.lang);
---

<a class="wa-fab" href={whatsappUrl()} target="_blank" rel="noopener noreferrer" data-wa-fab>
  <span class="wa-fab__ring" aria-hidden="true"></span>
  <Icon name="whatsapp" />
  <span class="wa-fab__tip">{t.common.fab}</span>
  <span class="visually-hidden"> — WhatsApp {t.common.newTab}</span>
</a>

<style>
  .wa-fab {
    --size: 60px;
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 85;
    width: var(--size);
    height: var(--size);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    text-decoration: none;
    box-shadow:
      0 10px 24px -6px rgb(18 140 74 / 0.55),
      0 2px 6px rgb(23 32 66 / 0.18);
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      opacity 0.5s var(--ease);
  }
  .wa-fab > :global(.icon) {
    position: relative;
    width: 32px;
    height: 32px;
  }
  /* soft pulse every few seconds */
  .wa-fab__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25d366;
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wa-fab__ring {
      animation: wa-pulse 3.2s var(--ease) 2s infinite;
    }
  }
  @keyframes wa-pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    45%,
    100% {
      transform: scale(1.7);
      opacity: 0;
    }
  }
  .wa-fab__tip {
    position: absolute;
    right: calc(100% + 14px);
    top: 50%;
    padding: 10px 16px;
    border-radius: 14px;
    background: var(--paper);
    color: var(--text);
    font-size: var(--fs-sm);
    font-weight: 650;
    line-height: 1.3;
    white-space: nowrap;
    box-shadow: var(--shadow);
    opacity: 0;
    transform: translate(8px, -50%);
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease),
      transform 0.4s var(--ease);
  }
  .wa-fab__tip::after {
    content: '';
    position: absolute;
    right: -5px;
    top: 50%;
    width: 10px;
    height: 10px;
    background: inherit;
    border-radius: 2px;
    transform: translateY(-50%) rotate(45deg);
  }
  .wa-fab:hover,
  .wa-fab:focus-visible {
    transform: scale(1.08) rotate(-6deg);
    box-shadow:
      0 14px 30px -6px rgb(18 140 74 / 0.6),
      0 2px 6px rgb(23 32 66 / 0.2);
  }
  .wa-fab:hover .wa-fab__tip,
  .wa-fab:focus-visible .wa-fab__tip,
  .wa-fab.is-hinting .wa-fab__tip {
    opacity: 1;
    transform: translate(0, -50%) rotate(6deg);
  }
  .wa-fab.is-hinting:not(:hover, :focus-visible) .wa-fab__tip {
    transform: translate(0, -50%);
  }
  .wa-fab:focus-visible {
    outline: 3px solid var(--sky-deep);
    outline-offset: 4px;
    border-radius: 50%;
  }
  .wa-fab:active {
    transform: scale(0.95);
  }
  @media (max-width: 640px) {
    .wa-fab {
      --size: 56px;
      right: max(14px, env(safe-area-inset-right));
      bottom: max(14px, env(safe-area-inset-bottom));
    }
    .wa-fab > :global(.icon) {
      width: 30px;
      height: 30px;
    }
  }
  /* stays out of the way of the first-visit loading screen */
  :global(html.has-loader) .wa-fab {
    opacity: 0;
    pointer-events: none;
  }
  @media print {
    .wa-fab {
      display: none;
    }
  }
</style>
