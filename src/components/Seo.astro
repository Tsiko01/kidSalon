---
import { site } from '../config/site';
import { href, locales, ogLocale, otherLang, type Lang, type PageKey } from '../i18n/routes';
import { abs, ogImage } from '../lib/schema';

interface Props {
  lang: Lang;
  /** null for the 404 page (no canonical / alternates, noindex) */
  page: PageKey | null;
  title: string;
  description: string;
  jsonLd?: object[];
  ogImageAlt: string;
}

const { lang, page, title, description, jsonLd = [], ogImageAlt } = Astro.props;
const canonical = page ? abs(href(lang, page)) : null;
---

<title>{title}</title>
<meta name="description" content={description} />
{
  canonical ? (
    <>
      <link rel="canonical" href={canonical} />
      {locales.map((l) => (
        <link rel="alternate" hreflang={l} href={abs(href(l, page!))} />
      ))}
      <link rel="alternate" hreflang="x-default" href={abs(href('ka', page!))} />
      <meta name="robots" content="index, follow, max-image-preview:large" />
    </>
  ) : (
    <meta name="robots" content="noindex, follow" />
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content={ogLocale[lang]} />
<meta property="og:locale:alternate" content={ogLocale[otherLang(lang)]} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#4aaef2" />
<meta name="format-detection" content="telephone=no" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
