---
/**
 * First-visit loading screen. Shown once per browser session (an inline
 * script in <head> adds `html.has-loader`), never with reduced motion and
 * never without JavaScript. The sequence is CSS-only (~1.9s), runs on top of
 * an already-rendered page and animates only transform/opacity, so it stays on
 * the compositor and never blocks the main thread.
 *
 * Sequence: sticker letters pop in one by one → scissors snip along a dashed
 * cut line → tagline → the sky panel lifts away with a curved trailing edge.
 */
import Icon from './Icon.astro';
import { logo } from './brand/paths';
import { useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const t = useT(Astro.props.lang);
const [vx, vy, vw, vh] = logo.viewBox.split(' ').map(Number);
const tf = (g: (typeof logo.glyphs)[number], off = 0) =>
  `translate(${g.dx + off} ${g.dy + off}) rotate(${g.rot} ${g.cx - g.dx} ${g.cy})`;
const origin = (g: (typeof logo.glyphs)[number]) =>
  `${(((g.cx - vx) / vw) * 100).toFixed(1)}% ${(((g.cy + g.dy - vy) / vh) * 100).toFixed(1)}%`;
---

<div class="loader" aria-hidden="true">
  <div class="loader__inner">
    <div class="loader__logo" style={`aspect-ratio:${vw} / ${vh}`}>
      {
        logo.glyphs.map((g, i) => (
          <svg class="loader__glyph" viewBox={logo.viewBox} style={`--i:${i};transform-origin:${origin(g)}`}>
            <use href={`#ks-g${i}`} transform={tf(g, 6)} class="loader__shadow" />
            <use href={`#ks-g${i}`} transform={tf(g)} class="loader__face" />
          </svg>
        ))
      }
    </div>
    <div class="loader__cut">
      <svg class="loader__line" viewBox="0 0 320 4" preserveAspectRatio="none">
        <line x1="0" y1="2" x2="320" y2="2"></line>
      </svg>
      <span class="loader__cover"></span>
      <span class="loader__track"><span class="loader__scissors"><Icon name="scissors" /></span></span>
    </div>
    <p class="loader__tag">{t.loader.line}</p>
  </div>
</div>

<style>
  .loader {
    display: none;
  }
  :global(html.has-loader) .loader {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: grid;
    place-items: center;
    background: var(--sky);
    color: var(--ink);
    animation: loader-out 0.8s var(--ease-io) 1.1s forwards;
    will-change: transform;
  }
  /* curved trailing edge, visible only while the panel lifts */
  .loader::after {
    content: '';
    position: absolute;
    left: -10%;
    top: calc(100% - 1px);
    width: 120%;
    height: 12vh;
    background: var(--sky);
    border-radius: 0 0 50% 50%;
  }
  .loader__inner {
    display: grid;
    justify-items: center;
    gap: 22px;
    animation: loader-inner 0.7s var(--ease-io) 1.1s forwards;
  }
  .loader__logo {
    position: relative;
    width: min(64vw, 340px);
  }
  .loader__glyph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    opacity: 0;
    will-change: transform, opacity;
    animation: glyph-pop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(0.05s + var(--i) * 45ms);
  }
  .loader__glyph use {
    stroke-width: 10;
    stroke-linejoin: round;
    paint-order: stroke;
  }
  .loader__shadow {
    fill: var(--ink);
    stroke: var(--ink);
  }
  .loader__face {
    fill: #fff;
    stroke: var(--ink);
  }
  .loader__cut {
    position: relative;
    width: min(54vw, 280px);
    height: 30px;
    overflow: hidden;
  }
  .loader__line {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 4px;
    transform: translateY(-50%);
    overflow: visible;
  }
  .loader__line line {
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-dasharray: 9 7;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  /* sky cover slides away to "cut" the line open */
  .loader__cover {
    position: absolute;
    inset: 0;
    background: var(--sky);
    animation: slide-right 0.75s var(--ease-io) 0.2s both;
  }
  .loader__track {
    position: absolute;
    inset: 0;
    animation: slide-right-track 0.75s var(--ease-io) 0.2s both;
  }
  .loader__scissors {
    position: absolute;
    left: 0;
    top: 0;
    width: 30px;
    height: 30px;
    margin-left: -15px;
    display: grid;
    place-items: center;
    background: var(--sun);
    border-radius: 50%;
    box-shadow: inset 0 0 0 2.5px var(--ink);
  }
  .loader__scissors :global(svg) {
    width: 17px;
    height: 17px;
    transform: rotate(90deg);
    animation: snip 0.18s ease-in-out 0.2s 4 alternate;
  }
  .loader__tag {
    font-size: var(--fs-sm);
    font-weight: 650;
    letter-spacing: 0.08em;
    opacity: 0;
    animation: fade-in 0.5s var(--ease) 0.55s forwards;
  }

  @keyframes glyph-pop {
    from {
      opacity: 0;
      transform: translateY(26%) scale(0.4) rotate(-14deg);
    }
    40% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes slide-right {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(101%);
    }
  }
  @keyframes slide-right-track {
    from {
      transform: translateX(15px);
    }
    to {
      transform: translateX(100%);
    }
  }
  @keyframes snip {
    to {
      transform: rotate(90deg) scaleX(0.7);
    }
  }
  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }
  @keyframes loader-out {
    to {
      transform: translateY(calc(-100% - 13vh));
      visibility: hidden;
    }
  }
  @keyframes loader-inner {
    to {
      transform: translateY(-10vh);
      opacity: 0;
    }
  }
</style>
