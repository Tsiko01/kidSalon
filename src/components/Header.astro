---
import Logo from './brand/Logo.astro';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import LangGlobe from './LangGlobe.astro';
import ThemeToggle from './ThemeToggle.astro';
import { href, headerNav, navOrder, useT, type Lang, type PageKey } from '../i18n';
import { site, telUrl, whatsappUrl } from '../config/site';

interface Props {
  lang: Lang;
  page: PageKey | null;
}
const { lang, page } = Astro.props;
const t = useT(lang);
const address = site.streetAddress ? `${site.streetAddress[lang]}, ${site.city[lang]}` : t.common.addressUnknown;
---

<header class="site-header" data-header>
  <div class="container site-header__bar">
    <a href={href(lang, 'home')} class="brand" aria-label={t.nav.homeLink}>
      <Logo variant="sticker" />
    </a>

    <nav class="site-nav" aria-label={t.nav.mainNav}>
      <ul role="list">
        {
          headerNav.map((key) => (
            <li>
              <a href={href(lang, key)} aria-current={page === key ? 'page' : undefined}>
                {t.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <LangSwitch lang={lang} page={page} />
      <LangGlobe lang={lang} page={page} class="only-mobile" />
      <ThemeToggle lang={lang} />
      <a class="btn btn--sun btn--sm header-book" href={href(lang, 'booking')}>
        {t.common.book}
        <Icon name="arrow" class="icon--arrow" />
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-open
      >
        <span class="menu-toggle__label">{t.nav.menu}</span>
        <span class="menu-toggle__bars" aria-hidden="true"><i></i><i></i></span>
        <span class="visually-hidden">{t.nav.openMenu}</span>
      </button>
    </div>
  </div>
</header>

<dialog id="site-menu" class="menu on-dark" aria-label={t.nav.menu} data-menu>
  <div class="menu__inner container">
    <div class="menu__top">
      <a href={href(lang, 'home')} class="brand" aria-label={t.nav.homeLink}>
        <Logo variant="sticker" />
      </a>
      <div class="menu__top-actions">
        <LangSwitch lang={lang} page={page} dark />
        <LangGlobe lang={lang} page={page} dark class="only-mobile" />
        <ThemeToggle lang={lang} dark />
        <button class="menu-close" type="button" data-menu-close>
          <Icon name="close" />
          <span class="visually-hidden">{t.nav.closeMenu}</span>
        </button>
      </div>
    </div>

    <nav class="menu__nav" aria-label={t.nav.menu}>
      <ol role="list" class="menu__list">
        {
          navOrder.map((key, i) => (
            <li style={`--i:${i}`}>
              <a href={href(lang, key)} aria-current={page === key ? 'page' : undefined}>
                <span class="menu__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="menu__label">{t.nav[key]}</span>
                <span class="menu__desc">{t.nav.menuDesc[key]}</span>
                <Icon name="chevron-right" class="menu__chev" />
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <aside class="menu__aside">
      <a class="btn btn--sun menu__book" href={href(lang, 'booking')}>
        {t.common.bookNow}
        <Icon name="arrow" class="icon--arrow" />
      </a>
      <ul role="list" class="menu__contacts">
        <li class="mc mc--phone">
          <a href={telUrl}><Icon name="phone" /><span class="mc__text">{site.phoneDisplay}</span></a>
        </li>
        <li class="mc mc--icon">
          <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" />
            <span class="mc__text">{t.common.whatsapp}</span>
            <span class="visually-hidden"> {t.common.newTab}</span>
          </a>
        </li>
        <li class="mc mc--addr">
          <Icon name="map-pin" />
          <span class="mc__text">{address}</span>
        </li>
        <li class="mc mc--icon">
          <a href={site.facebook} target="_blank" rel="noopener noreferrer">
            <Icon name="facebook" />
            <span class="mc__text">{t.common.followFacebook}</span>
            <span class="visually-hidden"> {t.common.newTab}</span>
          </a>
        </li>
        {
          site.instagram && (
            <li class="mc mc--icon">
              <a href={site.instagram} target="_blank" rel="noopener noreferrer">
                <Icon name="instagram" />
                <span class="mc__text">{t.common.followInstagram}</span>
                <span class="visually-hidden"> {t.common.newTab}</span>
              </a>
            </li>
          )
        }
      </ul>
    </aside>
  </div>
</dialog>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 90;
    height: var(--header-h);
    display: flex;
    align-items: center;
    transition:
      background-color 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      transform 0.5s var(--ease);
  }
  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: block;
    flex: none;
    width: clamp(84px, 8vw, 100px);
    transition: transform 0.5s var(--ease);
  }
  .brand:hover {
    transform: rotate(-4deg) scale(1.04);
  }
  .site-nav ul {
    display: flex;
    gap: clamp(8px, 1.4vw, 24px);
  }
  .site-nav a {
    position: relative;
    display: block;
    padding: 10px 6px;
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--text);
  }
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 4px;
    height: 2px;
    border-radius: 2px;
    background: var(--sky-deep);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease);
  }
  .site-nav a:hover::after,
  .site-nav a[aria-current]::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 8px 0 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    font-size: var(--fs-xs);
    font-weight: 700;
    transition: background-color 0.3s var(--ease);
  }
  .menu-toggle:hover {
    background: var(--sun-soft);
  }
  .menu-toggle__bars {
    display: grid;
    gap: 5px;
    width: 32px;
    height: 32px;
    place-content: center;
    border-radius: 50%;
    background: var(--text);
  }
  .menu-toggle__bars i {
    display: block;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: var(--bg);
    transition: width 0.3s var(--ease);
  }
  .menu-toggle__bars i:last-child {
    width: 9px;
  }
  .menu-toggle:hover .menu-toggle__bars i:last-child {
    width: 14px;
  }
  @media (max-width: 1080px) {
    .site-nav {
      display: none;
    }
  }
  .site-header__actions > :global(.lang-globe) {
    display: none;
  }
  @media (max-width: 640px) {
    .header-book,
    .site-header__actions > :global(.lang) {
      display: none;
    }
    .site-header__actions > :global(.lang-globe) {
      display: inline-flex;
    }
    .site-header__actions {
      gap: 8px;
    }
    .menu-toggle {
      padding-left: 14px;
    }
  }
  @media (max-width: 380px) {
    .brand {
      width: 76px;
    }
    .menu-toggle__label {
      display: none;
    }
    .menu-toggle {
      padding: 0 5px;
    }
  }

  /* ---------- full-screen menu ---------- */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ink);
    color: var(--cream);
    overflow-y: auto;
    overscroll-behavior: contain;
    clip-path: circle(0 at calc(100% - 56px) 40px);
    transition:
      clip-path 0.7s var(--ease-io),
      overlay 0.7s allow-discrete,
      display 0.7s allow-discrete;
  }
  .menu[open].is-open {
    clip-path: circle(150vmax at calc(100% - 56px) 40px);
  }
  .menu::backdrop {
    background: transparent;
  }
  .menu__inner {
    min-height: 100%;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr auto;
    gap: 32px;
    padding-bottom: 40px;
  }
  .menu__top {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .menu__top .brand {
    --logo-shadow: var(--sky);
  }
  .menu__top-actions {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .menu-close {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 0;
    background: var(--sun);
    color: var(--ink);
    transition: transform 0.4s var(--ease);
  }
  .menu-close:hover {
    transform: rotate(90deg);
  }
  .menu__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 4px 40px;
    align-content: center;
  }
  .menu__list a {
    display: grid;
    grid-template-columns: 2.2em 1fr;
    align-items: baseline;
    column-gap: 10px;
    padding: 14px 0;
    border-bottom: 1px solid rgb(255 248 236 / 0.12);
    text-decoration: none;
  }
  .menu__num {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--sky);
  }
  .menu__label {
    font-family: var(--f-display);
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem);
    font-weight: 520;
    font-variation-settings: 'SOFT' 100;
    line-height: 1.15;
    transition:
      color 0.3s var(--ease),
      transform 0.45s var(--ease);
  }
  .menu__desc {
    grid-column: 2;
    font-size: var(--fs-sm);
    color: rgb(255 248 236 / 0.7);
  }
  .menu__list a:hover .menu__label,
  .menu__list a[aria-current] .menu__label {
    color: var(--sun);
  }
  .menu__list a:hover .menu__label {
    transform: translateX(8px);
  }
  .menu__list li {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.5s var(--ease),
      transform 0.7s var(--ease);
  }
  .menu.is-open .menu__list li {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.14s + var(--i) * 30ms);
  }
  .menu__aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid rgb(255 248 236 / 0.12);
  }
  .menu__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    font-size: var(--fs-sm);
  }
  .menu__contacts li,
  .menu__contacts a {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .menu__contacts :global(.icon) {
    width: 18px;
    height: 18px;
    color: var(--sky);
  }
  .menu__contacts a {
    text-decoration: none;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
  }
  .menu__contacts a:hover {
    text-decoration: underline;
  }
  @media (prefers-reduced-motion: reduce) {
    .menu {
      clip-path: none;
    }
  }
  /* ---------- compact mobile menu (desktop keeps the large layout above) ---------- */
  .menu__list :global(.menu__chev) {
    display: none;
  }
  .menu__top-actions > :global(.lang-globe) {
    display: none;
  }
  @media (max-width: 767px) {
    .menu__inner {
      gap: 0;
      grid-template-rows: auto 1fr auto;
      padding-bottom: max(20px, env(safe-area-inset-bottom));
    }
    .menu__top {
      height: 68px;
      gap: 12px;
    }
    .menu__top .brand {
      width: 84px;
    }
    .menu__top-actions {
      gap: 8px;
    }
    .menu__top-actions > :global(.lang) {
      display: none;
    }
    .menu__top-actions > :global(.lang-globe) {
      display: inline-flex;
    }
    .menu-close {
      width: 44px;
      height: 44px;
    }
    .menu__nav {
      padding-top: 6px;
    }
    .menu__list {
      display: block;
    }
    .menu__list a {
      position: relative;
      grid-template-columns: 30px 1fr 18px;
      align-items: center;
      column-gap: 8px;
      padding: clamp(9px, 1.55svh, 14px) 6px;
      margin-inline: -6px;
      border-radius: 12px;
      border-bottom: 0;
      transition: background-color 0.25s var(--ease);
    }
    .menu__list li + li a::before {
      content: '';
      position: absolute;
      left: 6px;
      right: 6px;
      top: 0;
      border-top: 1px solid rgb(255 248 236 / 0.09);
    }
    .menu__num {
      font-size: 0.6875rem;
      letter-spacing: 0.06em;
      color: rgb(74 174 242 / 0.9);
    }
    .menu__label {
      font-size: 1.0625rem;
      font-weight: 560;
      line-height: 1.35;
      letter-spacing: 0.02em;
    }
    :lang(ka) .menu__label {
      letter-spacing: 0.012em;
    }
    .menu__desc {
      display: none;
    }
    .menu__list :global(.menu__chev) {
      display: block;
      width: 18px;
      height: 18px;
      color: rgb(255 248 236 / 0.38);
      transition:
        transform 0.35s var(--ease),
        color 0.25s var(--ease);
    }
    .menu__list a:hover .menu__label {
      transform: translateX(4px);
    }
    .menu__list a:hover :global(.menu__chev),
    .menu__list a:focus-visible :global(.menu__chev) {
      color: var(--sun);
      transform: translateX(3px);
    }
    .menu__list a:active {
      background: rgb(255 248 236 / 0.06);
    }
    .menu__list a[aria-current] :global(.menu__chev) {
      color: var(--sun);
    }
    .menu__aside {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      padding-top: 16px;
      margin-top: 8px;
    }
    .menu__contacts {
      order: -1;
      justify-content: center;
      gap: 10px;
    }
    .mc--addr {
      display: none !important;
    }
    .mc a {
      height: 44px;
      padding: 0 14px;
      border-radius: 999px;
      border: 1px solid rgb(255 248 236 / 0.18);
      transition: background-color 0.25s var(--ease);
    }
    .mc a:hover,
    .mc a:active {
      background: rgb(255 248 236 / 0.08);
      text-decoration: none;
    }
    .mc--icon a {
      width: 44px;
      padding: 0;
      justify-content: center;
    }
    .mc--icon .mc__text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .menu__book {
      width: 100%;
      min-height: 54px;
      font-size: 0.9375rem;
    }
  }
  @media (max-width: 767px) and (max-height: 620px) {
    .menu__list a {
      padding-block: 7px;
    }
    .menu__label {
      font-size: 1rem;
    }
  }
</style>
