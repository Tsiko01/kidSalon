---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { href, useT, type Lang } from '../i18n';
import { site } from '../config/site';
import type { Service } from '../config/services';
import { formatPrice } from '../lib/format';

interface Props {
  lang: Lang;
  service: Service;
  /** long = services page (with full description) */
  long?: boolean;
  index?: number;
  headingLevel?: 'h3' | 'h2';
}
const { lang, service: s, long = false, index = 0, headingLevel: H = 'h3' } = Astro.props;
const t = useT(lang);
const bookHref = href(lang, 'booking', `?service=${s.id}`);
---

<article class:list={['svc', `svc--${s.tone}`, { 'svc--long': long }]} id={long ? s.id : undefined} data-reveal style={`--d:${index}`}>
  {
    s.photo && (
      <Photo
        name={s.photo}
        alt={s.name[lang]}
        class="svc__photo media--zoom"
        ratio={long ? '4 / 3' : '4 / 5'}
        sizes={long ? '(min-width: 1100px) 400px, (min-width: 700px) 45vw, 92vw' : '(min-width: 1100px) 300px, (min-width: 700px) 45vw, 92vw'}
      />
    )
  }
  <div class="svc__body">
    <div class="svc__meta">
      <span class="svc__icon"><Icon name={s.icon} /></span>
      <span class="chip">{s.age[lang]}</span>
    </div>
    <H class="svc__title">{s.name[lang]}</H>
    <p class="svc__text">{long ? s.description[lang] : s.short[lang]}</p>
    <div class="svc__foot">
      <p class="svc__price">
        {formatPrice(s.price, lang, site.pricesIndicative)}
      </p>
      <a class="svc__book" href={bookHref}>
        <span>{t.common.bookThis}</span>
        <span class="visually-hidden">: {s.name[lang]}</span>
        <Icon name="arrow" />
      </a>
    </div>
  </div>
</article>

<style>
  .svc {
    --tone: var(--sky-soft);
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--r-lg);
    background: var(--paper);
    border: 1px solid var(--line);
    overflow: hidden;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  .svc:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }
  .svc--sun {
    --tone: var(--sun-soft);
  }
  .svc--pink {
    --tone: var(--pink-soft);
  }
  .svc--cream {
    --tone: var(--cream-2);
  }
  :global(.svc__photo) {
    border-radius: 0;
  }
  .svc__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 24px 24px;
    background: linear-gradient(var(--tone), var(--tone)) 0 0 / 100% 6px no-repeat;
  }
  .svc__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .svc__icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: var(--tone);
    color: var(--text);
  }
  .svc__title {
    font-family: var(--f-display);
    font-size: var(--fs-h4);
    font-weight: 600;
    font-variation-settings: 'SOFT' 100;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .svc__text {
    color: var(--ink-2);
    font-size: var(--fs-sm);
    flex: 1;
  }
  .svc__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    margin-top: 4px;
    border-top: 1px dashed var(--line-strong);
  }
  .svc__price {
    white-space: nowrap;
    font-family: var(--f-display);
    font-size: 1.5rem;
    font-weight: 650;
    font-variation-settings: 'SOFT' 100;
    line-height: 1;
  }
  .svc__book {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 6px 0 14px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .svc__book :global(.icon) {
    width: 32px;
    height: 32px;
    padding: 8px;
    border-radius: 50%;
    background: var(--sun);
    color: var(--ink);
    transition: transform 0.4s var(--ease);
  }
  .svc__book:hover {
    background: var(--sky);
    color: var(--ink);
  }
  .svc__book:hover :global(.icon) {
    transform: rotate(-45deg);
  }
  .svc--long .svc__text {
    font-size: var(--fs-base);
  }
</style>
