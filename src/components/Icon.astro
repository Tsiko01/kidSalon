---
/** Inline icon set (24×24, stroke = currentColor). Decorative unless `label` is given. */
export type IconName =
  | 'arrow' | 'arrow-up-right' | 'arrow-left' | 'chevron-down' | 'close' | 'menu' | 'plus' | 'check'
  | 'phone' | 'whatsapp' | 'facebook' | 'instagram' | 'map-pin' | 'clock' | 'calendar' | 'message'
  | 'scissors' | 'comb' | 'sparkle' | 'star' | 'heart' | 'bow' | 'fringe' | 'shield' | 'car' | 'users'
  | 'smile' | 'card' | 'expand' | 'google' | 'globe' | 'sun' | 'moon' | 'chevron-right';

interface Props {
  name: IconName;
  class?: string;
  label?: string;
  filled?: boolean;
}
const { name, class: cls = '', label, filled = false } = Astro.props;

