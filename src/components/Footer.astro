---
import Logo from './brand/Logo.astro';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { href, navOrder, useT, type Lang, type PageKey } from '../i18n';
import { site, telUrl, whatsappUrl, mapsUrl } from '../config/site';

interface Props {
  lang: Lang;
  page: PageKey | null;
}
const { lang, page } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
const address = site.streetAddress ? `${site.streetAddress[lang]}, ${site.city[lang]}` : t.common.addressUnknown;
---

<footer class="footer on-dark">
  <div class="container">
    <div class="footer__top">
      <p class="footer__big display" aria-hidden="true">{t.footer.bigLine}</p>
      <a class="btn btn--sun" href={href(lang, 'booking')}>
        {t.common.bookNow}
        <Icon name="arrow" class="icon--arrow" />
      </a>
    </div>

    <div class="footer__grid">
      <div class="footer__brand">
        <a href={href(lang, 'home')} class="footer__logo" aria-label={t.nav.homeLink}>
          <Logo variant="sticker" />
        </a>
        <p>{t.footer.tagline}</p>
      </div>

      <nav class="footer__col" aria-labelledby="footer-pages">
        <h2 id="footer-pages" class="footer__title">{t.footer.pages}</h2>
        <ul role="list" class="footer__links footer__links--two">
          {
            navOrder.map((key) => (
              <li>
                <a href={href(lang, key)} aria-current={page === key ? 'page' : undefined}>
                  {t.nav[key]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer__col">
        <h2 class="footer__title">{t.footer.contact}</h2>
        <address>
          <ul role="list" class="footer__links">
            <li>
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="footer__ic">
                <Icon name="map-pin" />
                <span>{address}<span class="visually-hidden"> {t.common.newTab}</span></span>
              </a>
            </li>
            <li>
              <a href={telUrl} class="footer__ic"><Icon name="phone" /><span>{site.phoneDisplay}</span></a>
            </li>
            <li>
              <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="footer__ic">
                <Icon name="whatsapp" />
                <span>{t.common.whatsapp}<span class="visually-hidden"> {t.common.newTab}</span></span>
              </a>
            </li>
          </ul>
        </address>
      </div>

      <div class="footer__col">
        <h2 class="footer__title">{t.footer.follow}</h2>
        <ul role="list" class="footer__social">
          <li>
            <a href={site.facebook} target="_blank" rel="noopener noreferrer">
              <Icon name="facebook" />
              <span class="visually-hidden">{t.common.followFacebook} {t.common.newTab}</span>
            </a>
          </li>
          {
            site.instagram && (
              <li>
                <a href={site.instagram} target="_blank" rel="noopener noreferrer">
                  <Icon name="instagram" />
                  <span class="visually-hidden">
                    {t.common.followInstagram} {t.common.newTab}
                  </span>
                </a>
              </li>
            )
          }
          <li>
            <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" />
              <span class="visually-hidden">{t.common.writeWhatsapp} {t.common.newTab}</span>
            </a>
          </li>
        </ul>
        <LangSwitch lang={lang} page={page} dark />
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {site.name}, {site.city[lang]}. {t.footer.rights}</p>
      <a href="#main" class="footer__top-link">
        {t.common.backTop}
        <Icon name="arrow" class="icon--up" />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--ink);
    color: var(--cream);
    padding-top: clamp(64px, 8vw, 112px);
    border-radius: var(--r-xl) var(--r-xl) 0 0;
    margin-top: calc(var(--r-xl) * -1);
    z-index: 2;
  }
  .footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding-bottom: clamp(40px, 6vw, 72px);
    border-bottom: 1px solid rgb(255 248 236 / 0.14);
  }
  .footer__big {
    font-size: clamp(2.5rem, 1.2rem + 5.5vw, 6.5rem);
    line-height: 1;
    color: var(--cream);
  }
  .footer__big::after {
    content: '.';
    color: var(--sun);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 1.2fr 1fr 0.8fr;
    gap: 40px;
    padding-block: clamp(40px, 6vw, 72px);
  }
  .footer__brand {
    display: grid;
    gap: 20px;
    align-content: start;
    max-width: 320px;
    color: rgb(255 248 236 / 0.78);
  }
  .footer__logo {
    --logo-shadow: var(--sky);
    width: 128px;
    display: block;
    transform: rotate(-3deg);
    transition: transform 0.5s var(--ease);
  }
  .footer__logo:hover {
    transform: rotate(2deg) scale(1.04);
  }
  .footer__title {
    font-family: var(--f-body);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sky);
    margin-bottom: 18px;
  }
  :lang(ka) .footer__title {
    text-transform: none;
    letter-spacing: 0.04em;
    font-size: var(--fs-sm);
  }
  .footer address {
    font-style: normal;
  }
  .footer__links {
    display: grid;
    gap: 6px;
  }
  .footer__links--two {
    grid-template-columns: repeat(2, minmax(0, max-content));
    column-gap: 32px;
  }
  .footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    text-decoration: none;
    color: rgb(255 248 236 / 0.86);
    transition: color 0.25s var(--ease);
  }
  .footer__links a:hover,
  .footer__links a[aria-current] {
    color: var(--sun);
  }
  .footer__ic {
    gap: 10px;
  }
  .footer__ic :global(.icon) {
    width: 18px;
    height: 18px;
    color: var(--sky);
  }
  .footer__social {
    display: flex;
    gap: 10px;
    margin-bottom: 24px;
  }
  .footer__social a {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgb(255 248 236 / 0.24);
    color: var(--cream);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .footer__social a:hover {
    background: var(--sun);
    color: var(--ink);
    transform: translateY(-3px);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    padding-block: 24px 32px;
    padding-right: 84px; /* room for the floating WhatsApp button */
    border-top: 1px solid rgb(255 248 236 / 0.14);
    font-size: var(--fs-xs);
    color: rgb(255 248 236 / 0.7);
  }
  .footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    text-decoration: none;
    font-weight: 650;
    color: var(--cream);
  }
  .footer__top-link :global(.icon--up) {
    width: 16px;
    height: 16px;
    transform: rotate(-90deg);
  }
  @media (max-width: 960px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
    .footer__bottom {
      padding-bottom: 96px;
    }
  }
</style>
