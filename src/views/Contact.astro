---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { href, useT, type Lang } from '../i18n';
import { site, telUrl, whatsappUrl, mapsUrl } from '../config/site';
import { photoSlots } from '../config/photos';
import { fullAddress } from '../lib/format';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const c = t.contact;
const address = fullAddress(lang);
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&hl=${lang}&z=16&output=embed`;

const cards = [
  { icon: 'phone', title: c.cards.phoneTitle, text: c.cards.phoneText, action: site.phoneDisplay, href: telUrl, external: false, tone: 'sun' },
  { icon: 'whatsapp', title: c.cards.waTitle, text: c.cards.waText, action: c.cards.waAction, href: whatsappUrl(c.waGreeting), external: true, tone: 'wa' },
  { icon: 'facebook', title: c.cards.fbTitle, text: c.cards.fbText, action: c.cards.fbAction, href: site.facebook, external: true, tone: 'sky' },
  ...(site.instagram
    ? [{ icon: 'instagram', title: c.cards.igTitle, text: c.cards.igText, action: c.cards.igAction, href: site.instagram, external: true, tone: 'pink' }]
    : []),
] as const;
---

<Base lang={lang} page="contact" pageType="ContactPage" preload={{ name: 'contact-hero', sizes: '(min-width: 960px) 40vw, 92vw' }}>
  <PageHero lang={lang} page="contact" eyebrow={c.eyebrow} title={c.title} lead={c.lead} photo={{ name: 'contact-hero', alt: photoSlots['contact-hero'].alt[lang] }}>
    <a class="btn btn--sun" href={telUrl}><Icon name="phone" />{site.phoneDisplay}</a>
    <a class="btn btn--wa" href={whatsappUrl(c.waGreeting)} target="_blank" rel="noopener noreferrer">
      <Icon name="whatsapp" />
      {t.common.whatsapp}
      <span class="visually-hidden">{t.common.newTab}</span>
    </a>
  </PageHero>

  <section class="section section--tight contact-cards" aria-label={c.eyebrow}>
    <div class="container">
      <ul role="list" class="cards" style={`--n:${cards.length}`}>
        {
          cards.map((card, i) => (
            <li data-reveal style={`--d:${i}`}>
              <a
                class={`ccard ccard--${card.tone}`}
                href={card.href}
                {...(card.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="ccard__icon"><Icon name={card.icon as IconName} /></span>
                <h2 class="ccard__title">{card.title}</h2>
                <p class="ccard__text">{card.text}</p>
                <span class="ccard__action">
                  {card.action}
                  <Icon name={card.external ? 'arrow-up-right' : 'arrow'} />
                </span>
                {card.external && <span class="visually-hidden">{t.common.newTab}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section where" aria-labelledby="where-title">
    <div class="container where__grid">
      <div class="where__info" data-reveal>
        <h2 id="where-title" class="h2">{c.whereTitle}</h2>
        <dl class="info">
          <div class="info__row">
            <dt><span class="info__icon"><Icon name="map-pin" /></span>{t.common.address}</dt>
            <dd>
              <address>
                {address ?? t.common.addressUnknown}
                {!address && <span class="info__note">{t.common.addressUnknownNote}</span>}
              </address>
            </dd>
          </div>
          <div class="info__row">
            <dt><span class="info__icon"><Icon name="clock" /></span>{t.common.hours}</dt>
            <dd>
              {
                site.hours ? (
                  <ul role="list" class="hours">
                    {site.hours.map((h) => (
                      <li>
                        <span>{h.label[lang]}</span>
                        <span>
                          <time datetime={h.opens}>{h.opens}</time>–<time datetime={h.closes}>{h.closes}</time>
                        </span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <>
                    {t.common.hoursUnknown}
                    <span class="info__note">{t.common.hoursUnknownNote}</span>
                  </>
                )
              }
            </dd>
          </div>
          <div class="info__row">
            <dt><span class="info__icon"><Icon name="phone" /></span>{t.common.phone}</dt>
            <dd><a href={telUrl}>{site.phoneDisplay}</a></dd>
          </div>
        </dl>
        <a class="btn btn--ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="map-pin" />
          {c.mapOpen}
          <span class="visually-hidden">{t.common.newTab}</span>
        </a>
      </div>

      <div class="map" data-map data-src={mapEmbed} data-title={c.mapFrameTitle} data-reveal="scale">
        <svg class="map__art" viewBox="0 0 600 460" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <rect width="600" height="460" fill="#e7f3fc"></rect>
          <g fill="#d6ead0">
            <rect x="30" y="40" width="150" height="110" rx="18"></rect>
            <rect x="420" y="300" width="150" height="130" rx="18"></rect>
          </g>
          <g fill="none" stroke="#fff" stroke-linecap="round">
            <path d="M-20 210 C 120 190 240 240 360 210 S 560 160 640 190" stroke-width="34"></path>
            <path d="M250 -20 C 240 120 290 300 260 480" stroke-width="26"></path>
            <path d="M-20 360 L 640 300" stroke-width="18"></path>
            <path d="M430 -20 L 470 480" stroke-width="16"></path>
            <path d="M80 480 L 150 -20" stroke-width="12"></path>
          </g>
          <g fill="none" stroke="#b9dcf6" stroke-width="2" stroke-dasharray="6 8">
            <path d="M-20 210 C 120 190 240 240 360 210 S 560 160 640 190"></path>
          </g>
        </svg>
        <div class="map__pin" aria-hidden="true">
          <span class="map__pin-dot"><Icon name="scissors" /></span>
          <span class="map__pin-label">Kids Salon</span>
        </div>
        <div class="map__ui">
          <h3 class="map__title">{c.mapTitle}</h3>
          <p class="map__addr">{address ?? t.common.addressUnknown}</p>
          <button type="button" class="btn" data-map-load><Icon name="map-pin" />{c.mapShow}</button>
          <p class="map__note">{c.mapNote}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="cfaq-title">
    <div class="container">
      <div class="cfaq" data-reveal>
        <span class="cfaq__icon"><Icon name="message" /></span>
        <div>
          <h2 id="cfaq-title" class="cfaq__title">{c.faqTitle}</h2>
          <p>{c.faqText}</p>
        </div>
        <a class="btn btn--ghost" href={href(lang, 'faq')}>{t.common.readFaq}<Icon name="arrow" class="icon--arrow" /></a>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .contact-cards {
    padding-top: 0;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
    gap: 18px;
  }
  .ccard {
    --tone: var(--sun);
    position: relative;
    height: 100%;
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 28px;
    border-radius: var(--r-lg);
    background: var(--paper);
    border: 1px solid var(--line);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  .ccard::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 180px;
    height: 180px;
    right: -60px;
    top: -60px;
    border-radius: 50%;
    background: var(--tone);
    opacity: 0.25;
    transition: transform 0.7s var(--ease);
  }
  .ccard:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }
  .ccard:hover::before {
    transform: scale(1.5);
  }
  .ccard--wa {
    --tone: #1f9d55;
  }
  .ccard--sky {
    --tone: var(--sky);
  }
  .ccard--pink {
    --tone: var(--pink);
  }
  .ccard__icon {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    background: var(--tone);
    color: var(--ink);
    margin-bottom: 8px;
  }
  .ccard--wa .ccard__icon {
    color: #fff;
  }
  .ccard__title {
    font-size: var(--fs-h4);
  }
  .ccard__text {
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .ccard__action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    font-weight: 700;
  }
  .ccard__action :global(.icon) {
    width: 18px;
    height: 18px;
    transition: transform 0.35s var(--ease);
  }
  .ccard:hover .ccard__action :global(.icon) {
    transform: translate(3px, -3px);
  }
  .where {
    padding-top: calc(var(--section) * 0.5);
  }
  .where__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .where__info {
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .info {
    display: grid;
    gap: 22px;
    margin: 0;
    width: 100%;
  }
  .info__row {
    display: grid;
    gap: 8px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line);
  }
  .info dt {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--ink-2);
  }
  .info__icon {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--sky-soft);
    color: var(--text);
  }
  .info__icon :global(.icon) {
    width: 18px;
    height: 18px;
  }
  .info dd {
    margin: 0 0 0 48px;
    font-size: var(--fs-lg);
    font-weight: 600;
  }
  .info address {
    font-style: normal;
  }
  .info__note {
    display: block;
    margin-top: 4px;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-2);
  }
  .info dd a {
    text-decoration: none;
  }
  .info dd a:hover {
    text-decoration: underline;
  }
  .hours li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .map {
    position: relative;
    min-height: 460px;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--sky-soft);
    box-shadow: var(--shadow);
  }
  .map__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  :global(:root[data-theme='dark']) .map__art {
    filter: brightness(0.42) saturate(0.8);
  }
  .map__pin {
    position: absolute;
    left: 50%;
    top: 28%;
    display: grid;
    justify-items: center;
    gap: 6px;
    transform: translate(-50%, -50%);
  }
  .map__pin-dot {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--ink);
    color: var(--sun);
    box-shadow: 0 12px 24px -8px rgb(23 32 66 / 0.6);
    animation: pin-bounce 2.4s var(--ease) infinite;
  }
  .map__pin-dot :global(.icon) {
    transform: rotate(45deg);
  }
  @keyframes pin-bounce {
    0%,
    70%,
    100% {
      translate: 0 0;
    }
    35% {
      translate: 0 -10px;
    }
  }
  .map__pin-label {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--paper);
    font-size: var(--fs-xs);
    font-weight: 700;
    box-shadow: var(--shadow-sm);
  }
  .map__ui {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    display: grid;
    gap: 8px;
    justify-items: start;
    padding: 22px;
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(6px);
  }
  .map__title {
    font-size: var(--fs-h4);
  }
  .map__addr {
    font-weight: 600;
  }
  .map__ui .btn {
    margin-top: 6px;
  }
  .map__note {
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }
  .map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map.is-loaded .map__ui,
  .map.is-loaded .map__pin {
    display: none;
  }
  .cfaq {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 24px;
    align-items: center;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--r-xl);
    background: var(--cream-2);
  }
  .cfaq__icon {
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    border-radius: 20px;
    background: var(--paper);
  }
  .cfaq__title {
    font-size: var(--fs-h4);
    margin-bottom: 4px;
  }
  .cfaq p {
    color: var(--ink-2);
  }
  @media (max-width: 1000px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
    .where {
    padding-top: calc(var(--section) * 0.5);
  }
  .where__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .cards,
    .cfaq {
      grid-template-columns: 1fr;
    }
    .map {
      min-height: 520px;
    }
  }
</style>
