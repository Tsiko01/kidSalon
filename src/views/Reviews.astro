---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ReviewsBlock from '../components/ReviewsBlock.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { fmt, useT, type Lang } from '../i18n';
import { photoSlots } from '../config/photos';
import { reviews, reviewLinks } from '../config/reviews';
import { whatsappUrl } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const r = t.reviewsPage;
const avg = reviews.length ? reviews.reduce((a, x) => a + x.rating, 0) / reviews.length : 0;
---

<Base lang={lang} page="reviews" preload={{ name: 'about-1', sizes: '(min-width: 960px) 40vw, 92vw' }}>
  <PageHero lang={lang} page="reviews" eyebrow={r.eyebrow} title={r.title} lead={r.lead} photo={{ name: 'about-1', alt: photoSlots['about-1'].alt[lang] }}>
    {
      reviews.length > 0 && (
        <div class="rv-summary">
          <span class="rv-summary__score">{avg.toFixed(1)}</span>
          <span>
            <span class="rv-summary__label">{r.average}</span>
            <span class="rv-summary__count">{fmt(r.count, { n: reviews.length })}</span>
          </span>
        </div>
      )
    }
  </PageHero>

  <section class="section section--sand" aria-labelledby="rv-title">
    <div class="container">
      <h2 id="rv-title" class="visually-hidden">{r.title}</h2>
      <ReviewsBlock lang={lang} emptyTitle={r.emptyTitle} emptyText={r.emptyText} />
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="container how__grid">
      <div class="how__head" data-reveal>
        <h2 id="how-title" class="h2">{r.howTitle}</h2>
        <a class="btn" href={reviewLinks.facebook} target="_blank" rel="noopener noreferrer">
          <Icon name="facebook" />
          {t.reviewsBlock.write}
          <span class="visually-hidden">{t.common.newTab}</span>
        </a>
      </div>
      <ol role="list" class="how">
        {
          r.how.map((step, i) => (
            <li data-reveal style={`--d:${i}`}>
              <span class="how__num">{i + 1}</span>
              <div>
                <h3 class="how__title">{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="container">
      <div class="private" data-reveal>
        <span class="private__icon"><Icon name="message" /></span>
        <div>
          <h2 class="private__title">{r.privateTitle}</h2>
          <p>{r.privateText}</p>
        </div>
        <a class="btn btn--wa" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" />
          {t.reviewsBlock.whatsapp}
          <span class="visually-hidden">{t.common.newTab}</span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .rv-summary {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 22px 12px 12px;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .rv-summary__score {
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--sun);
    color: var(--ink);
    font-family: var(--f-display);
    font-size: 1.5rem;
    font-weight: 700;
  }
  .rv-summary__label {
    display: block;
    font-weight: 700;
  }
  .rv-summary__count {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .how__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .how__head {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .how {
    display: grid;
    gap: 16px;
    counter-reset: how;
  }
  .how li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    align-items: start;
    padding: 24px;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .how__num {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--sky-soft);
    font-family: var(--f-display);
    font-size: 1.5rem;
    font-weight: 650;
  }
  .how__title {
    font-size: 1.1875rem;
    margin-bottom: 4px;
  }
  .how p {
    color: var(--ink-2);
  }
  .private {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 24px;
    align-items: center;
    margin-top: clamp(40px, 6vw, 72px);
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--r-xl);
    background: var(--pink-soft);
  }
  .private__icon {
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    border-radius: 20px;
    background: var(--paper);
  }
  .private__title {
    font-family: var(--f-display);
    font-size: var(--fs-h4);
    margin-bottom: 4px;
  }
  .private p {
    color: var(--ink-2);
  }
  @media (max-width: 860px) {
    .how__grid,
    .private {
      grid-template-columns: 1fr;
    }
  }
</style>
