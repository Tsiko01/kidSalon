---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { fmt, href, useT, type Lang, type PageKey } from '../i18n';
import { site, telUrl, whatsappUrl } from '../config/site';
import { formatHours, fullAddress } from '../lib/format';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const f = t.faq;
const q = f.items;
const address = fullAddress(lang);

type Item = { id: string; q: string; a: string; link?: { page: PageKey; label: string } };
const groups: { id: keyof typeof f.groups; icon: 'calendar' | 'scissors' | 'map-pin'; items: Item[] }[] = [
  {
    id: 'booking',
    icon: 'calendar',
    items: [
      { id: 'how', q: q.how.q, a: fmt(q.how.a, { phone: site.phoneDisplay }), link: { page: 'booking', label: f.linkBooking } },
      { id: 'confirmed', q: q.confirmed.q, a: q.confirmed.a },
      { id: 'reschedule', q: q.reschedule.q, a: q.reschedule.a },
      { id: 'siblings', q: q.siblings.q, a: q.siblings.a },
    ],
  },
  {
    id: 'visit',
    icon: 'scissors',
    items: [
      { id: 'ages', q: q.ages.q, a: q.ages.a, link: { page: 'services', label: f.linkServices } },
      { id: 'scared', q: q.scared.q, a: q.scared.a, link: { page: 'guide', label: f.linkGuide } },
      { id: 'stay', q: q.stay.q, a: q.stay.a },
      { id: 'first', q: q.first.q, a: q.first.a, link: { page: 'guide', label: f.linkGuide } },
      { id: 'duration', q: q.duration.q, a: q.duration.a },
    ],
  },
  {
    id: 'practical',
    icon: 'map-pin',
    items: [
      { id: 'prices', q: q.prices.q, a: site.pricesIndicative ? q.prices.aIndicative : q.prices.a, link: { page: 'services', label: f.linkServices } },
      { id: 'hours', q: q.hours.q, a: site.hours ? fmt(q.hours.a, { hours: formatHours(site.hours, lang) }) : q.hours.aUnknown },
      { id: 'location', q: q.location.q, a: address ? fmt(q.location.a, { address }) : q.location.aUnknown, link: { page: 'contact', label: f.linkContact } },
      { id: 'payment', q: q.payment.q, a: site.paymentMethods ? fmt(q.payment.a, { methods: site.paymentMethods[lang] }) : q.payment.aUnknown },
    ],
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: groups.flatMap((g) =>
    g.items.map((it) => ({
      '@type': 'Question',
      name: it.q,
      acceptedAnswer: { '@type': 'Answer', text: it.a },
    })),
  ),
};
---

<Base lang={lang} page="faq" jsonLd={[faqSchema]}>
  <PageHero lang={lang} page="faq" eyebrow={f.eyebrow} title={f.title} lead={f.lead}>
    <a class="btn btn--wa" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
      <Icon name="whatsapp" />
      {t.common.writeWhatsapp}
      <span class="visually-hidden">{t.common.newTab}</span>
    </a>
  </PageHero>

  <section class="section faq" aria-label={f.title}>
    <div class="container faq__grid">
      <nav class="faq__nav" aria-label={t.guide.tocLabel}>
        <ul role="list">
          {
            groups.map((g) => (
              <li>
                <a href={`#group-${g.id}`}>
                  <Icon name={g.icon} />
                  {f.groups[g.id]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="faq__groups">
        {
          groups.map((g) => (
            <section class="faq__group" id={`group-${g.id}`} aria-labelledby={`group-${g.id}-title`}>
              <h2 class="faq__group-title" id={`group-${g.id}-title`}>
                <span class="faq__group-icon"><Icon name={g.icon} /></span>
                {f.groups[g.id]}
              </h2>
              <div class="acc-list">
                {g.items.map((it) => (
                  <details class="acc" id={it.id}>
                    <summary>
                      <h3 class="acc__q">{it.q}</h3>
                      <span class="acc__icon" aria-hidden="true"><Icon name="plus" /></span>
                    </summary>
                    <div class="acc__a">
                      <p>{it.a}</p>
                      {it.link && (
                        <a class="link-arrow" href={href(lang, it.link.page)}>
                          {it.link.label}
                          <Icon name="arrow" />
                        </a>
                      )}
                    </div>
                  </details>
                ))}
              </div>
            </section>
          ))
        }

        <div class="faq__still">
          <div>
            <h2 class="faq__still-title">{f.stillTitle}</h2>
            <p>{f.stillText}</p>
          </div>
          <div class="btn-row">
            <a class="btn btn--wa" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" />
              {t.common.whatsapp}
              <span class="visually-hidden">{t.common.newTab}</span>
            </a>
            <a class="btn btn--ghost" href={telUrl}><Icon name="phone" />{site.phoneDisplay}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .faq {
    padding-top: 0;
  }
  .faq__grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .faq__nav {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }
  .faq__nav ul {
    display: grid;
    gap: 8px;
  }
  .faq__nav a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 18px;
    border-radius: 16px;
    background: var(--paper);
    border: 1px solid var(--line);
    font-weight: 650;
    text-decoration: none;
    transition: background-color 0.25s var(--ease);
  }
  .faq__nav a:hover {
    background: var(--sun-soft);
  }
  .faq__nav :global(.icon) {
    width: 20px;
    height: 20px;
    color: var(--sky-deep);
  }
  .faq__groups {
    display: grid;
    gap: clamp(40px, 6vw, 72px);
  }
  .faq__group {
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .faq__group-title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
    font-size: var(--fs-h3);
  }
  .faq__group-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    background: var(--sun);
    color: var(--ink);
  }
  .acc-list {
    display: grid;
    gap: 12px;
  }
  .acc {
    border-radius: var(--r);
    background: var(--paper);
    border: 1px solid var(--line);
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .acc[open] {
    border-color: var(--sky);
    box-shadow: 0 0 0 3px var(--sky-soft);
  }
  .acc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 22px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--r);
  }
  .acc summary::-webkit-details-marker {
    display: none;
  }
  .acc__q {
    font-family: var(--f-body);
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.45;
  }
  .acc__icon {
    flex: none;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--sky-soft);
    transition:
      transform 0.45s var(--ease),
      background-color 0.3s var(--ease);
  }
  .acc__icon :global(.icon) {
    width: 18px;
    height: 18px;
  }
  .acc[open] .acc__icon {
    transform: rotate(135deg);
    background: var(--sun);
    color: var(--ink);
  }
  .acc summary:hover .acc__icon {
    background: var(--sun-soft);
  }
  .acc__a {
    display: grid;
    gap: 12px;
    justify-items: start;
    padding: 0 22px 22px;
    color: var(--ink-2);
    max-width: 70ch;
  }
  .acc__a .link-arrow {
    color: var(--text);
    font-size: var(--fs-sm);
  }
  @media (prefers-reduced-motion: no-preference) {
    .acc {
      interpolate-size: allow-keywords;
    }
    .acc::details-content {
      block-size: 0;
      overflow-y: clip;
      transition:
        block-size 0.45s var(--ease),
        content-visibility 0.45s allow-discrete;
    }
    .acc[open]::details-content {
      block-size: auto;
    }
  }
  .faq__still {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--r-xl);
    background: var(--sky-soft);
  }
  .faq__still-title {
    font-size: var(--fs-h3);
    margin-bottom: 6px;
  }
  .faq__still p {
    color: var(--ink-2);
  }
  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
    .faq__nav {
      position: static;
    }
    .faq__nav ul {
      display: flex;
      flex-wrap: wrap;
    }
  }
</style>
